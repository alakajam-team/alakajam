{
  "name": "alakajam",
  "version": "2.0.0-dev",
  "description": "Website powering the Alakajam! game making community",
  "license": "MIT",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently -k -n server,client,css -c blue,green,magenta \"npm start\" \"npm run dev:client\" \"npm run build:css -- --watch\"",
    "start": "nodemon",
    "start:e2e": "node -r @swc-node/register -r tsconfig-paths/register server/scripts/e2e.ts",
    "start:debug": "node --inspect-brk -r @swc-node/register -r tsconfig-paths/register server/index.ts",
    "start:production": "node dist/server/index.js",
    "build": "npm run build:css && npm run build:client && npm run build:server",
    "build:css": "ts-node --transpile-only server/scripts/sass.ts",
    "build:client": "vite build",
    "dev:client": "vite build --watch --mode development",
    "build:server": "tsc --build tsconfig.build.json",
    "lint": "npm run lint:server && npm run lint:client && npm run lint:e2e",
    "lint:server": "eslint server/ --fix",
    "lint:client": "eslint client/ --fix",
    "lint:e2e": "eslint e2e/ playwright.config.ts --fix",
    "test": "vitest",
    "test:e2e": "npm run build:css && npm run build:client && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ci": "npm run test:unit:ci && npm run test:e2e",
    "test:unit:ci": "vitest run",
    "knex": "ts-node --transpile-only -r tsconfig-paths/register ./node_modules/knex/bin/cli.js --knexfile server/core/knexfile.ts",
    "migrate:latest": "node deployment/verify-data-folder.js && npm run knex -- migrate:latest",
    "migrate:rollback": "npm run knex -- migrate:rollback",
    "migrate:currentVersion": "npm run knex -- migrate:currentVersion",
    "docs": "typedoc --out dist/docs --exclude **/*.spec.ts,**/*.controller.ts,**/migrations/*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alakajam-team/alakajam.git"
  },
  "bugs": {
    "url": "https://github.com/alakajam-team/alakajam/issues"
  },
  "dependencies": {
    "@babel/plugin-proposal-optional-chaining": "^7.13.8",
    "@twurple/api": "^8.2.0",
    "@twurple/auth": "^8.2.0",
    "body-parser": "^1.19.0",
    "bookshelf": "^0.15.2",
    "bookshelf-cascade-delete": "^2.0.1",
    "cheerio": "^1.0.0-rc.5",
    "chokidar": "^3.5.1",
    "connect-session-knex": "^2.0.0",
    "cookies": "^0.8.0",
    "countries-and-timezones": "^2.3.1",
    "csurf": "^1.11.0",
    "download": "^8.0.0",
    "eventemitter2": "^6.4.4",
    "express": "^4.17.1",
    "express-promise-router": "^4.0.1",
    "express-session": "^1.17.1",
    "express-slow-down": "^1.4.0",
    "find": "^0.3.0",
    "find-up": "^5.0.0",
    "fs-extra": "^9.1.0",
    "hcaptcha": "^0.1.0",
    "html-to-text": "^7.0.0",
    "jsx-pistols": "^0.5.1",
    "knex": "^0.17.6",
    "left-pad": "^1.3.0",
    "lodash": "^4.17.21",
    "longjohn": "^0.2.12",
    "luxon": "^1.26.0",
    "mime-types": "^2.1.29",
    "mkdirp": "^1.0.4",
    "module-alias": "^2.2.2",
    "multer": "^1.4.2",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.5.0",
    "npm": "^7.6.3",
    "pg": "^8.5.1",
    "preact": "^10.25.4",
    "preact-render-to-string": "^6.5.13",
    "random-key": "^0.3.2",
    "reflect-metadata": "^0.1.13",
    "remove-markdown": "^0.3.0",
    "request": "^2.88.2",
    "request-promise-native": "^1.0.9",
    "sanitize-html": "^2.3.3",
    "showdown": "^1.9.0",
    "slug": "^4.0.3",
    "sqlite3": "^5.0.2",
    "striptags": "^3.0.1",
    "timezone-support": "^2.0.2",
    "truncate-html": "^1.0.3",
    "turndown": "^7.0.0",
    "typeorm": "^0.2.31",
    "validator": "^13.5.2",
    "winston": "^3.3.3"
  },
  "optionalDependencies": {
    "sharp": "^0.27.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fortawesome/fontawesome-free": "^5.15.3",
    "@playwright/test": "^1.64.1",
    "@rollup/plugin-inject": "^5.0.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.20",
    "@ttskch/select2-bootstrap4-theme": "^1.5.2",
    "@types/body-parser": "^1.19.0",
    "@types/bookshelf": "^0.13.3",
    "@types/chai": "^4.2.15",
    "@types/copy": "^0.3.1",
    "@types/csurf": "^1.11.0",
    "@types/express": "^4.17.11",
    "@types/express-serve-static-core": "^4.17.19",
    "@types/find": "^0.2.1",
    "@types/fs-extra": "^9.0.8",
    "@types/jquery": "^3.5.5",
    "@types/luxon": "^1.26.2",
    "@types/multer": "^1.4.5",
    "@types/node": "^22.12.0",
    "@types/nodemailer": "^6.4.1",
    "@types/sass": "^1.16.0",
    "@types/sharp": "^0.27.1",
    "@types/showdown": "^1.9.3",
    "@types/sinon": "^9.0.11",
    "@types/slug": "^0.9.1",
    "bootstrap": "^4.6.0",
    "bootstrap-notify": "^3.1.3",
    "chai": "^4.3.4",
    "chartist": "^0.11.4",
    "colorette": "^2.0.20",
    "concurrently": "^6.0.0",
    "copy": "^0.3.2",
    "easymde": "^2.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "flipclock": "^0.10.8",
    "globals": "^17.13.0",
    "icheck": "^1.0.2",
    "jquery-lazy": "^1.7.11",
    "lodash.template": "^4.5.0",
    "nodemon": "^3.1.14",
    "popper.js": "^1.16.1",
    "sass": "^1.106.1",
    "select2": "^4.0.13",
