    "sortablejs": "^1.13.0",
    "tablesort": "^5.2.1",
    "tempusdominus-bootstrap-4": "^5.39.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.27.6",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.5",
    "vitest": "^3.2.7"
  },
  "_moduleAliases": {
    "server": "dist/server"
  }
}
